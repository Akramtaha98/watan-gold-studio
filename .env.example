# Leave DATABASE_URL unset for project-local watan_gold_studio.db.
# DATABASE_URL=sqlite:////absolute/path/watan_gold_studio.db
# Supabase uses its PostgreSQL connection string, never the HTTP API URL:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=require
# DATABASE_SCHEMA=warisan
# Keep this PostgreSQL schema out of Supabase Exposed schemas.
# RELEASES_DIR=/absolute/private/path/releases
QWEN_BASE_URL=http://127.0.0.1:8000/v1
QWEN_MODEL=Qwen/Qwen3-8B
# QWEN_API_KEY=loaded-from-your-secret-manager
# Generate random secrets: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
PTSL_API_TOKEN=
PTSL_API_REVIEWER_ROLES=Linguist
# Optional outbound webhook. HTTPS required except localhost in development.
PTSL_WEBHOOK_URL=
PTSL_WEBHOOK_SECRET=
# Explicit CORS origins only, if a trusted browser client is required.
PTSL_ALLOWED_ORIGINS=
# Production fails closed unless STUDIO_ACCESS_TOKEN has at least 32 chars.
STUDIO_ENV=development
STUDIO_ACCESS_TOKEN=
